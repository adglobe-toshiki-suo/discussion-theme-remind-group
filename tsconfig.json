{
  "include": ["src/**/*"],
  "compilerOptions": {
    "target": "ES2024",
    "module": "commonjs",
    "lib": ["ES2024", "DOM"],
    "allowJs": false,
    "outDir": "./dist",
    "strict": true /* Enable all strict type-checking options. */,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true
  }
}
